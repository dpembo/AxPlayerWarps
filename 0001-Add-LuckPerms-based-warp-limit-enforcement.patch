     public PlayerListeners() {
         for (Player player : Bukkit.getOnlinePlayers()) {
@@ -19,6 +23,11 @@ public class PlayerListeners implements Listener {
     @EventHandler
     public void onJoin(PlayerJoinEvent event) {
